# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Данные и результаты (генерируются)
data/chunks/
# Промежуточные конвертации/OCR (генерируются scripts/prepare_docs.py).
data/raw/pdf/
data/raw/ocr/
# Приватный корпус документов (PDF/RTF/ODT) — не публикуется в git.
# Файлы лежат локально и нужны пайплайну, но в репозиторий не попадают.
data/raw/sources/
data/raw/manifest.json
results/*.json
results/*.jsonl
results/*.md
!results/.gitkeep
# Отчёт — часть сдаваемого результата, его держим в репозитории.
!results/REPORT.md

# Локальные конфиги и секреты
.env
configs/hw/*.local.env
configs/llms/*.local.env

# Приватная документация/материалы — не публикуются в git
docs/

# Образы/контекст docker (тяжёлые бинарники кладутся на хост, не в git)
docker/llamacpp/vendor/
models/
*.gguf

# IDE
.idea/
.vscode/