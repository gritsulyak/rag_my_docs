# ============================================================================
# normdoc-assistant — пример конфигурации. Скопируйте в .env и заполните.
# ВАЖНО: реальные ключи/секреты храните только в .env (в git не попадает).
# ============================================================================

# --- Векторная БД Qdrant -----------------------------------------------------
# Локальный запуск: http://localhost:6333; в docker-compose: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=normdoc_e5_small
QDRANT_PORT=6333
# Хост-порт gRPC (в контейнере всегда 6334). Меняйте при конфликте с другим Qdrant.
QDRANT_GRPC_PORT=6334

# --- Корпус документов -------------------------------------------------------
# Каталог с оригинальными документами (pdf/rtf/odt). По умолчанию data/raw/sources.
# SOURCES_DIR=/полный/путь/к/документам

# --- LLM: провайдер ----------------------------------------------------------
# openai   — OpenAI-совместимый API (llama.cpp, Ollama, vLLM, LM Studio, Авито)
# gigachat — облачный API Sber GigaChat (OAuth + REST)
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8080/v1
# в docker-compose: LLM_BASE_URL=http://llama:8080/v1
LLM_MODEL=bonsai
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=65536
LLM_TIMEOUT=600
# reasoning_effort: none (быстро) | low | medium | high | auto (не передавать)
LLM_REASONING=none

# --- GigaChat API (Sber), используется при LLM_PROVIDER=gigachat -------------
# GIGACHAT_CREDENTIALS = base64(client_id:client_secret) из developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# 1 — проверять TLS (нужен корневой сертификат Минцифры); 0 — отключить (тесты)
GIGACHAT_VERIFY_SSL=0

# --- Эмбеддинги (локальные) --------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# auto | cpu | cuda | mps (для ROCm torch видит GPU как cuda)
EMBEDDING_DEVICE=auto
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Реранкер (bge-reranker-v2-m3) -------------------------------------------
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_BATCH=8
RETRIEVE_CANDIDATES=20

# --- Чанкинг и ретривер ------------------------------------------------------
CHUNKING_MODE=semantic
CHUNK_TARGET_TOKENS=400
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_RATIO=0.12
# Символьный фолбэк:
CHUNK_SIZE=600
CHUNK_OVERLAP=60
TOP_K=5
MIN_SCORE=0.0

# --- Парсер ------------------------------------------------------------------
PARSE_TABLES=1
PARSE_FIGURES=1
SANITIZE_LINKS=1

# --- Мониторинг Langfuse -----------------------------------------------------
# 0 — выключен; 1 — трейсы в self-hosted (docker profile monitoring) или облако.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=pk-lf-normdoc
LANGFUSE_SECRET_KEY=sk-lf-normdoc
# Для скриптов на хосте (report/load): http://localhost:3000.
# Внутри compose контейнер app всегда ходит на внутренний http://langfuse-web:3000
# (переменная LANGFUSE_INTERNAL_HOST, см. docker-compose.yml) — эту строку в
# контейнер подставлять нельзя, иначе трейсы не уйдут.
LANGFUSE_HOST=http://localhost:3000
# Fallback без Langfuse-сервера: писать трейсы (вопрос, спаны, latency) в JSONL.
# Оставьте пустым, если не нужно. Пример: TRACE_JSONL=results/traces_local.jsonl
TRACE_JSONL=

# Образы объектного хранилища (S3) для self-hosted Langfuse (profile monitoring).
# Официальные minio/minio и minio/mc недоступны на Docker Hub (pull access denied),
# поэтому по умолчанию — совместимое зеркало pgsty (в образе minio уже есть mc):
MINIO_IMAGE=pgsty/minio:latest
MC_IMAGE=pgsty/mc:latest

# --- Профили железа / LLM / эмбеддингов (см. configs/) -----------------------
# HW_PROFILE=amd_7840hs | ai395_strix_hala | intel_rtx3060
# LLM_PROFILE=bonsai | meno | gigachat | t_lite | qvikhr | ruadapt | saiga | qwen | avito
# EMBEDDING_PROFILE=e5_small | bge_m3 | giga_embeddings | user_bge_m3 | roberta

# --- Docker: модели и порты --------------------------------------------------
# Каталог с GGUF-моделями на хосте (монтируется в /models в контейнере llama).
# Положите сюда хотя бы один *.gguf (иначе контейнер llama выйдет с «GGUF не найден»).
# Экономия места: hardlink на уже скачанную модель, например
#   ln ~/models/meno-lite/meno-lite-0.1-Q4_K_M.gguf ./models/
MODELS_DIR=./models
# MODEL_FILE=/models/meno-lite-0.1-Q4_K_M.gguf   # если в каталоге несколько моделей
MODEL_ALIAS=meno-lite
# N_CTX=32768
# N_GPU_LAYERS=99
# N_PARALLEL=4
# THREADS=8
APP_PORT=8000

# --- llama.cpp: предсобранный PrismML Vulkan-релиз (профиль amd7840hs / 780M) --
# Каталог с готовыми бинарниками llama.cpp (Vulkan), монтируется в контейнер
# llama-7840hs в /opt/prism (read-only). По умолчанию — каталог рядом с репо
# (совпадает с scripts/serve_llm.sh и scripts/start_meno.sh). Внутри релиза
# entrypoint сам находит llama-server (файл llama-prism-*/llama-server).
PRISM_VULKAN_DIR=../../llm_eng/prism-vulkan
# Кладите в каталог сам релиз (llama-prism-*) или распакованный prism-vulkan.tar.gz.
# GID групп доступа к /dev/dri (проверить: `getent group video render`).
# Нужны профилям Vulkan/ROCm; по умолчанию — как в Ubuntu (video=44, render=992).
# VIDEO_GID=44
# RENDER_GID=992

# --- Пороги quality gate RAGAS (используются с --gate) -----------------------
THRESH_FAITHFULNESS=0.70
THRESH_CONTEXT_PRECISION=0.40
THRESH_CONTEXT_RECALL=0.60
