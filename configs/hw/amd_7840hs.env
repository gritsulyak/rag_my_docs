# --- Железо: AMD Ryzen 7 7840HS + Radeon 780M (iGPU), 32 ГБ RAM ---
# Домашняя dev-машина проекта. GPU не используется (только CPU),
# поэтому модель эмбеддингов — компактная e5-small.
HW_PROFILE=amd_7840hs
EMBEDDING_DEVICE=cpu
RERANK_DEVICE=cpu
RERANK_BATCH=4
RETRIEVE_CANDIDATES=20
LLM_MAX_TOKENS=1024
