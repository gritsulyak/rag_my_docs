# --- Железо: AMD Ryzen 7 7840HS + Radeon 780M (iGPU), 32 ГБ RAM ---
# Домашняя dev-машина проекта. LLM можно вынести на iGPU через Vulkan-профиль
# docker-compose `amd7840hs` (предсобранные бинарники PrismML, PRISM_VULKAN_DIR).
# Эмбеддинги и реранкер оставляем на CPU (torch CPU): компактная e5-small и
# меньше конкуренции за общую с iGPU память.
HW_PROFILE=amd_7840hs
EMBEDDING_DEVICE=cpu
RERANK_DEVICE=cpu
RERANK_BATCH=4
RETRIEVE_CANDIDATES=20
LLM_MAX_TOKENS=1024
