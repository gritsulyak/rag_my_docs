# --- Железо: AMD Ryzen AI MAX+ 395 (Strix Halo) + Radeon 8060S, 128 ГБ unified ---
# Продовый целевой профиль: много памяти и мощный iGPU (gfx1151).
# Эмбеддинги и реранкер можно грузить на GPU через ROCm; bnonsai/локальная LLM
# с большим контекстом (unified memory позволяет держать 27B и реранкер вместе).
HW_PROFILE=ai395_strix_hala
# ROCm: EMBEDDING_DEVICE=cuda (torch видит ROCm как cuda). Для CPU-only: cpu.
EMBEDDING_DEVICE=auto
RERANK_DEVICE=auto
RERANK_BATCH=16
RETRIEVE_CANDIDATES=30
TOP_K=6
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=131072
