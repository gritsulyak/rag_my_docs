# --- Железо: Intel CPU + NVIDIA RTX 3060 (12 ГБ VRAM) ---
# Эмбеддинги и реранкер ускоряются на CUDA. LLM — на той же/отдельной GPU
# через llama.cpp (CUDA-сборка), порт 8080.
HW_PROFILE=intel_rtx3060
EMBEDDING_DEVICE=cuda
RERANK_DEVICE=cuda
RERANK_BATCH=16
RETRIEVE_CANDIDATES=30
TOP_K=6
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=65536
