# --- Embeddings: Giga-Embeddings-instruct (Sber, ru/en) ---
# Русскоязычный SOTA-эмбеддер Sber, инструктивный (query/passage в промпте).
# Требует trust_remote_code=1 и sentence-transformers >= 3.0.
EMBEDDING_PROFILE=giga_embeddings
EMBEDDING_MODEL=ai-sage/Giga-Embeddings-instruct
EMBEDDING_DIM=2048
EMBEDDING_DEVICE=auto
EMBEDDING_TRUST_REMOTE_CODE=1
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
