# --- LLM: RuadaptQwen3-8B-Hybrid (RefalMachine) ---
# Скачать GGUF: huggingface-cli download RefalMachine/RuadaptQwen3-8B-Hybrid-GGUF
# Запуск: scripts/serve_llm.sh ruadapt   (порт 8085)
LLM_PROFILE=ruadapt
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8085/v1
LLM_MODEL=ruadapt-qwen3-8b
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
