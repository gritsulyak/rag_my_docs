# --- LLM: Meno-Lite-0.1 (7B, Qwen2.5-RAG) на порту 8081 ---
# Альтернативная специализированная RAG-модель. Запуск на втором инстансе
# llama.cpp, чтобы не трогать bonsai на 8080 (см. README, startup-menolite.sh).
LLM_PROFILE=meno
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=meno-lite
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
