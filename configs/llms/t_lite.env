# --- LLM: T-lite-it-2.1 (T-Bank, Qwen3-8B) ---
# Скачать GGUF: huggingface-cli download t-tech/T-lite-it-2.1-GGUF
# Запуск: scripts/serve_llm.sh t_lite   (порт 8083)
LLM_PROFILE=t_lite
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8083/v1
LLM_MODEL=t-lite
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
