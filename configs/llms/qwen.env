# --- LLM: Qwen2.5-7B-Instruct (нейтральный мультиязычный бейзлайн) ---
# Скачать GGUF: huggingface-cli download Qwen/Qwen2.5-7B-Instruct-GGUF
# Запуск: scripts/serve_llm.sh qwen   (порт 8087)
LLM_PROFILE=qwen
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8087/v1
LLM_MODEL=qwen2.5-7b
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
