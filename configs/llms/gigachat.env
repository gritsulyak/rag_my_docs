# --- LLM: GigaChat3.1-10B-A1.8B (Sber), локально через llama.cpp ---
# MoE: 10B всего / ~1.8B активных параметров -> быстрая на CPU, ~6 ГБ при Q4_K_M.
# Скачать GGUF: huggingface-cli download ai-sage/GigaChat3.1-10B-A1.8B-GGUF
# Запуск: scripts/serve_llm.sh gigachat   (порт 8082)
LLM_PROFILE=gigachat
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8082/v1
LLM_MODEL=gigachat
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
