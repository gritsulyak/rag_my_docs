# --- LLM: Avito A-vibe ---
# Веса A-vibe не опубликованы. Профиль предполагает внутренний
# OpenAI-совместимый эндпоинт Авито (или собственный inference-сервер).
# Укажите адрес и имя модели ниже; формат ответа — стандартный OpenAI.
LLM_PROFILE=avito
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=a-vibe
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=300
