# --- LLM: bonsai 2 (27B ternary) из PrismML-форка llama.cpp, порт 8080 ---
# Это дефолтная модель проекта. Порт 8080 занят запущенным bonsai.
LLM_PROFILE=bonsai
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=bonsai
LLM_REASONING=none
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=65536
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
