# --- LLM: GigaChat (облачный API Sber) ---
# Требует GIGACHAT_CREDENTIALS = base64(client_id:client_secret) из developers.sber.ru.
# Для облака нужен корневой сертификат Минцифры; при его отсутствии — GIGACHAT_VERIFY_SSL=0.
LLM_PROFILE=gigachat_api
LLM_PROVIDER=gigachat
GIGACHAT_MODEL=GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=0
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
