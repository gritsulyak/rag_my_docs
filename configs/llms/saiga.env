# --- LLM: Saiga Llama3 8B (IlyaGusev) ---
# Скачать GGUF: huggingface-cli download IlyaGusev/saiga_llama3_8b_gguf
# Запуск: scripts/serve_llm.sh saiga   (порт 8086)
LLM_PROFILE=saiga
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8086/v1
LLM_MODEL=saiga
LLM_REASONING=off
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
