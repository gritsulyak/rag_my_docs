# --- LLM: быстрый локальный ассистент (сравнение, порт 8082) ---
# Любая небольшая instruct-модель (например Qwen2.5-3B-Instruct) для быстрых
# прогонов RAGAS, когда латентность важнее качества.
LLM_PROFILE=fast_local
LLM_BASE_URL=http://127.0.0.1:8082/v1
LLM_MODEL=fast-local
LLM_REASONING=off
LLM_MAX_TOKENS=1536
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
